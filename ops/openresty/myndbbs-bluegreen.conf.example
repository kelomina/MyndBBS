# Install as an included OpenResty snippet. Keep only one color active.
upstream myndbbs_frontend {
  include /usr/local/openresty/nginx/conf/conf.d/myndbbs-frontend-active-upstream.inc;
}
upstream myndbbs_backend {
  include /usr/local/openresty/nginx/conf/conf.d/myndbbs-backend-active-upstream.inc;
}

# Initial active snippets are created by the install script. The scripts replace
# them atomically. frontend ports: 3311 / 3312; backend ports: 3301 / 3302.

# The active color is changed by replacing this include atomically and running
# nginx -t before reload. Never expose blue/green ports directly.
server {
  listen 443 ssl;
  server_name kolobbs.kolostudio.fun;
  # nginx caps the whole request body incl. multipart framing; app file limit is 10485760 B, so keep this strictly greater.
  client_max_body_size 12m;
  location /api/ { proxy_pass http://myndbbs_backend; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
  location / { proxy_pass http://myndbbs_frontend; proxy_set_header Host $host; proxy_set_header X-Forwarded-Proto $scheme; }
}
