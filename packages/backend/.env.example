JWT_SECRET=<generate-64-random-hex-characters>
JWT_REFRESH_SECRET=<generate-a-different-64-random-hex-characters>
# Production requires a separate temporary-token secret. Use a third value different from both JWT secrets.
# 生产环境必须配置安装/临时令牌专用密钥，并且必须不同于 JWT_SECRET 和 JWT_REFRESH_SECRET。
TEMP_TOKEN_SECRET=<generate-a-third-64-random-hex-secret>
# Database password used by docker-compose for POSTGRES_PASSWORD and DATABASE_URL interpolation.
# Docker Compose 部署时用于 POSTGRES_PASSWORD 和 DATABASE_URL 插值的数据库密码。
DB_PASSWORD=<generate-a-strong-database-password>
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
PORT=3001
DATABASE_URL="postgresql://postgres:<database-password>@localhost:5432/myndbbs?schema=public"
REDIS_PASSWORD=<generate-a-strong-redis-password>
REDIS_URL=redis://:<redis-password>@localhost:6379
RP_ID=localhost
ORIGIN=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=MyndBBS <no-reply@example.com>
EMAIL_VERIFICATION_TTL_MINUTES=30
PASSWORD_RESET_TTL_MINUTES=30
# Keep installation locked by default. For first-time local setup only, set INSTALL_LOCKED=false.
# 默认关闭安装向导。仅首次本地初始化时临时改为 INSTALL_LOCKED=false。
INSTALL_LOCKED=true
NODE_ENV=development

# Plugin platform v2 is opt-in. Empty endpoint/token leaves mutations unavailable;
# ordinary installations do not need plugin secrets or the Compose plugins profile.
# Set PLUGIN_CONTROL_URL=http://plugin-control:3600 only after provisioning.
PLUGIN_CONTROL_URL=
PLUGIN_CONTROL_TOKEN=
# Independent 32-byte base64 encryption key; never reuse a JWT/control/signing key.
PLUGIN_CONFIG_ENCRYPTION_KEY=
PLUGIN_MANIFEST_ROOT=/app/plugin-releases
PLUGIN_ALLOWLIST_FILE=/app/plugin-releases/allowlist.json

# Compose-only public paths (absolute paths on the Docker daemon host).
PLUGIN_HOST_DIR=/opt/myndbbs/plugins
PLUGIN_TRUST_KEYS_HOST_FILE=/opt/myndbbs/plugin-trust-keys.json
PLUGIN_CONTROL_ENV_FILE=/opt/myndbbs/secrets/plugin-control.env
PLUGIN_RUNTIME_NETWORK=myndbbs_plugin_runtime
PLUGIN_INFRA_IMAGE_TAG=latest
# Set COMPOSE_PROFILES=plugins explicitly only after backup and readiness review.
# PLUGIN_RUNTIME_SECRET must ONLY exist in PLUGIN_CONTROL_ENV_FILE (32+ chars).
# NEVER put it in this backend .env, container env_file, image, or plugin runtime.
# PLUGIN_SIGNING_KEY (Ed25519 private PEM) belongs only in a CI protected
# plugin-signing environment or an offline signer. No runtime needs the private key.
# PLUGIN_SIGNING_KEY_ID is a public CI variable matching manifest.signatureKeyId
# and the corresponding entry in the operator-maintained {"keys":{...}} trust file.
# See ops/plugins/README.md for backup, approval, rotation, and rollback.

# Bundled verification provider: requires a signed, approved, active v2 release.
HUMAN_VERIFICATION_PLUGIN_ID=human-verification
# Non-secret revocation epoch. Rotate across all core nodes BEFORE restoring Redis snapshots.
HUMAN_VERIFICATION_PROOF_EPOCH=v1
